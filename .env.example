# InsideHQ - RAG Employee Knowledge Assistant
# Environment Variables Configuration Template

# Application
PROJECT_NAME="InsideHQ Knowledge Assistant"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5434
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="pass"
POSTGRES_DB="insidehq"
DATABASE_URL="postgresql+asyncpg://postgres:pass@localhost:5434/insidehq"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:pass@localhost:5434/insidehq"

# Authentication & Security
JWT_SECRET_KEY="your_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM (Google Gemini)
GROQ_API_KEY="your_secret_key"
GROQ_MODEL="gemini-3.6-flash"

# Embedding & Reranking Models (Local sentence-transformers)
EMBEDDING_MODEL_NAME="BAAI/bge-large-en-v1.5"
RERANKER_MODEL_NAME="BAAI/bge-reranker-large"

# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY="your_secret_key"
LANGFUSE_SECRET_KEY="your_secret_key"
LANGFUSE_HOST="https://cloud.langfuse.com"
